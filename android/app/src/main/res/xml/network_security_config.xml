<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP allowed for classroom LAN Gemini proxy (PC IP / emulator 10.0.2.2). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
