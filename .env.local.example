# Copy to .env.local (gitignored). Never commit real secrets.

# Local direct Gemini (scripts/run_dev.ps1) — ONLY on your PC, never share
GEMINI_API_KEY=

# Shared app token checked by the Spring Boot proxy (OK inside classmate APK)
DRIFTLINE_APP_TOKEN=
GEMINI_APP_TOKEN=

# Flutter → backend proxy (NO Gemini API key in the APK)
# Emulator: http://10.0.2.2:8080/api/v1/gemini/generate
# Physical phones / camarades (same Wi‑Fi): http://<PC_LAN_IP>:8080/api/v1/gemini/generate
# Production: https://your-public-host/api/v1/gemini/generate
#
# Classroom helper (auto LAN IP + optional APK):
#   .\scripts\share_gemini_proxy.ps1
#   .\scripts\build_apk_lan.ps1
GEMINI_PROXY_URL=http://10.0.2.2:8080/api/v1/gemini/generate

GEMINI_MODEL=gemini-3-flash-preview
PORT=8080

# Required for valeur ajoutée POI + routing demos:
# 1) https://opentripmap.io / https://dev.opentripmap.org → create free key
# 2) https://openrouteservice.org/dev/#/signup → create free key
# Then: .\scripts\sync_dart_defines.ps1  and relaunch Flutter.
OPENTRIPMAP_API_KEY=
OPENROUTESERVICE_API_KEY=
